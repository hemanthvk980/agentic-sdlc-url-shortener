# Copy to .env (git-ignored) and fill in. Never commit real values.

# Orchestrator (live mode: --llm gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# URL shortener service (prod profile)
APP_BASE_URL=http://localhost:8080
APP_ADMIN_API_KEY=
DATABASE_URL=jdbc:postgresql://localhost:5432/shortener
DATABASE_USERNAME=shortener
DATABASE_PASSWORD=
