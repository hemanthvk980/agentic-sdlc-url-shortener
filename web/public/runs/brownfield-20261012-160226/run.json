      "node": "design",
      "kind": "DESIGN_CHOICE",
      "actor": "agent:design",
      "summary": "Reuse create() per entry",
      "rationale": "Batch delegates to the existing single-create path | alternatives: [Bulk INSERT] | consequences: Identical validation/alias/expiry behaviour; 50 inserts per request is acceptable at this scale."
    },
