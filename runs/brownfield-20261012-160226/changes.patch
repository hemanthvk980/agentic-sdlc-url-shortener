+package io.github.hemanthvk980.shortener.link.api;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.util.UUID;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+
+@SpringBootTest(properties = {"app.base-url=https://sho.rt", "app.rate-limit.enabled=false"})
+@AutoConfigureMockMvc
+class BatchCreateIntegrationTest {
+
+    @Autowired MockMvc mvc;
+
+    private static String entry(String url, String alias) {
+        return alias == null ? "{\"url\":\"" + url + "\"}" : "{\"url\":\"" + url + "\",\"alias\":\"" + alias + "\"}";
+    }
+
+    @Test
+    void ac1_createsAllLinksInRequestOrder() throws Exception {
+        String a = "b-" + UUID.randomUUID().toString().substring(0, 8);
+        String body = "{\"links\":[" + entry("https://example.com/1", a) + "," + entry("https://example.com/2", null) + "]}";
+        mvc.perform(post("/api/v1/links/batch").contentType(MediaType.APPLICATION_JSON).content(body))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.links.length()").value(2))
+                .andExpect(jsonPath("$.links[0].code").value(a))
+                .andExpect(jsonPath("$.links[1].targetUrl").value("https://example.com/2"));
+    }
+
+    @Test
+    void ac2_oneInvalidEntryRejectsTheWholeBatch() throws Exception {
+        String a = "b-" + UUID.randomUUID().toString().substring(0, 8);
+        String body = "{\"links\":[" + entry("https://example.com/ok", a) + "," + entry("javascript:alert(1)", null) + "]}";
+        mvc.perform(post("/api/v1/links/batch").contentType(MediaType.APPLICATION_JSON).content(body))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.errors.1").exists());
+        mvc.perform(get("/api/v1/links/" + a)).andExpect(status().isNotFound());
+    }
+
+    @Test
+    void ac3_duplicateAliasWithinBatchIsRejected() throws Exception {
+        String a = "b-" + UUID.randomUUID().toString().substring(0, 8);
+        String body = "{\"links\":[" + entry("https://example.com/x", a) + "," + entry("https://example.com/y", a) + "]}";
+        mvc.perform(post("/api/v1/links/batch").contentType(MediaType.APPLICATION_JSON).content(body))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.errors.1").value("duplicate alias within batch"));
+    }
+
+    @Test
+    void ac4_sizeLimitsAreEnforced() throws Exception {
+        String tooMany = IntStream.range(0, 51).mapToObj(i -> entry("https://example.com/" + i, null)).collect(Collectors.joining(","));
+        mvc.perform(post("/api/v1/links/batch").contentType(MediaType.APPLICATION_JSON).content("{\"links\":[" + tooMany + "]}"))
+                .andExpect(status().isBadRequest());
+        mvc.perform(post("/api/v1/links/batch").contentType(MediaType.APPLICATION_JSON).content("{\"links\":[]}"))
+                .andExpect(status().isBadRequest());
+    }
+}
