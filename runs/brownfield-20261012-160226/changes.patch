+package io.github.hemanthvk980.shortener.link.service;
+
+import java.util.Map;
+
+/** One or more batch entries are invalid; maps entry index to the reason. Nothing was created. */
+public class BatchValidationException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+
+    private final transient Map<Integer, String> errors;
+
+    public BatchValidationException(Map<Integer, String> errors) {
+        super(errors.size() + " batch entr" + (errors.size() == 1 ? "y is" : "ies are") + " invalid");
+        this.errors = Map.copyOf(errors);
+    }
+
+    public Map<Integer, String> errors() {
+        return errors;
+    }
+}
