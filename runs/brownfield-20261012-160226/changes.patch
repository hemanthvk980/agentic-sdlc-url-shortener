+    /**
+     * All-or-nothing batch: every entry is validated before anything is written and all inserts share
+     * one transaction, so a failure (including an alias conflict found on insert) leaves no partial batch.
+     */
+    @Transactional
+    public List<Link> createBatch(List<CreateLinkCommand> commands) {
+        Map<Integer, String> errors = new LinkedHashMap<>();
+        Set<String> aliases = new HashSet<>();
+        for (int i = 0; i < commands.size(); i++) {
+            CreateLinkCommand c = commands.get(i);
+            try {
+                validator.validateAndNormalize(c.url());
+                if (c.alias() != null && !aliases.add(c.alias())) errors.put(i, "duplicate alias within batch");
+            } catch (InvalidUrlException e) {
+                errors.put(i, e.getMessage());
+            }
+        }
+        if (!errors.isEmpty()) throw new BatchValidationException(errors);
+        List<Link> created = new ArrayList<>(commands.size());
+        for (CreateLinkCommand c : commands) created.add(create(c));
+        return created;
+    }
