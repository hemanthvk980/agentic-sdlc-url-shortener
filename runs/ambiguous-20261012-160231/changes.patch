+package io.github.hemanthvk980.shortener.link.api;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+
+@SpringBootTest(properties = {"app.base-url=https://sho.rt", "app.rate-limit.enabled=false"})
+@AutoConfigureMockMvc
+class StatsWindowIntegrationTest {
+
+    @Autowired MockMvc mvc;
+    @Autowired ObjectMapper json;
+
+    private String create() throws Exception {
+        String body = mvc.perform(post("/api/v1/links").contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\":\"https://example.com/campaign\"}"))
+                .andExpect(status().isCreated()).andReturn().getResponse().getContentAsString();
+        return json.readTree(body).get("code").asText();
+    }
+
+    @Test
+    void ac1_defaultWindowIs30DaysForExistingClients() throws Exception {
+        String code = create();
+        mvc.perform(get("/api/v1/links/" + code + "/stats")).andExpect(status().isOk()).andExpect(jsonPath("$.days").value(30));
+    }
+
+    @Test
+    void ac2_windowIsConfigurableWithinBounds() throws Exception {
+        String code = create();
+        mvc.perform(get("/api/v1/links/" + code + "/stats?days=7")).andExpect(status().isOk()).andExpect(jsonPath("$.days").value(7));
+        mvc.perform(get("/api/v1/links/" + code + "/stats?days=90")).andExpect(status().isOk());
+        mvc.perform(get("/api/v1/links/" + code + "/stats?days=6")).andExpect(status().isBadRequest());
+        mvc.perform(get("/api/v1/links/" + code + "/stats?days=91")).andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void ac3_countsDistinctReferrers() throws Exception {
+        String code = create();
+        mvc.perform(get("/" + code).header("Referer", "https://a.example/x"));
+        mvc.perform(get("/" + code).header("Referer", "https://a.example/y"));
+        mvc.perform(get("/" + code).header("Referer", "https://b.example/"));
+        mvc.perform(get("/" + code));
+        JsonNode stats = null;
+        for (int i = 0; i < 50; i++) {
+            stats = json.readTree(mvc.perform(get("/api/v1/links/" + code + "/stats")).andReturn().getResponse().getContentAsString());
+            if (stats.get("totalClicks").asLong() == 4) break;
+            Thread.sleep(100);
+        }
+        org.junit.jupiter.api.Assertions.assertEquals(2, stats.get("distinctReferrers").asLong());
+    }
+}
