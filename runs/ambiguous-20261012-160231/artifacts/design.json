{
  "summary": "Add a configurable stats window (?days, 7-90, default 30 — unchanged for existing clients, per reviewer) and a distinctReferrers count. Additive, backward-compatible.",
  "components": [
    {
      "name": "Stats API",
      "responsibility": "window parameter + new field",
      "files": [
        "url-shortener-service/src/main/java/io/github/hemanthvk980/shortener/link/api/LinkController.java",
        "url-shortener-service/src/main/java/io/github/hemanthvk980/shortener/link/service/LinkService.java",
        "url-shortener-service/src/main/java/io/github/hemanthvk980/shortener/link/service/LinkStats.java",
        "url-shortener-service/src/main/java/io/github/hemanthvk980/shortener/link/repo/ClickEventRepository.java"
      ]
    }
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/v1/links/{code}/stats",
      "request": "?days=7..90 (default 30)",
      "responses": [
        "200 LinkStats{days, distinctReferrers, ...}",
        "400",
        "404"
      ],
      "notes": ""
    }
  ],
  "dataModel": [],
  "adrs": [
    {
      "title": "Query-time aggregation",
      "decision": "Aggregate click_event at request time using the (link_id, click_date) index",
      "alternatives": [
        "Pre-aggregated daily table"
      ],
      "consequences": "No schema change; fine up to ~10^6 events per link within 90 days."
    }
  ],
  "risks": [
    {
      "risk": "Response shape gains fields (days, distinctReferrers)",
      "likelihood": "LOW",
      "impact": "LOW",
      "mitigation": "Additive JSON fields; documented in changelog."
    }
  ],
