+package io.github.hemanthvk980.shortener.service;
+
+import io.github.hemanthvk980.shortener.domain.ClickEvent;
+import io.github.hemanthvk980.shortener.domain.Link;
+import io.github.hemanthvk980.shortener.repo.ClickEventRepository;
+import io.github.hemanthvk980.shortener.repo.LinkRepository;
+import java.security.SecureRandom;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+import java.util.List;
+import java.util.NoSuchElementException;
+import org.springframework.scheduling.annotation.Async;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+public class LinkService {
+    private static final String ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+    private final SecureRandom random = new SecureRandom();
+    private final LinkRepository links;
+    private final ClickEventRepository clicks;
+    private final UrlValidator validator;
+
+    public LinkService(LinkRepository links, ClickEventRepository clicks, UrlValidator validator) {
+        this.links = links;
+        this.clicks = clicks;
+        this.validator = validator;
+    }
+
+    @Transactional
+    public Link create(String url) {
+        String target = validator.validate(url);
+        for (int i = 0; i < 5; i++) {
+            String code = nextCode();
+            if (!links.existsByCode(code)) return links.save(new Link(code, target, Instant.now()));
+        }
+        throw new IllegalStateException("could not allocate a code");
+    }
+
+    @Transactional(readOnly = true)
+    public Link resolve(String code) {
+        return links.findByCode(code).orElseThrow(() -> new NoSuchElementException("no link " + code));
+    }
+
+    @Async
+    @Transactional
+    public void recordClick(Long linkId) {
+        clicks.save(new ClickEvent(linkId, Instant.now()));
+        links.incrementClicks(linkId);
+    }
+
+    @Transactional(readOnly = true)
+    public List<ClickEventRepository.Daily> daily(Link link) {
+        return clicks.countByDay(link.getId(), LocalDate.now(ZoneOffset.UTC).minusDays(29));
+    }
+
+    private String nextCode() {
+        char[] c = new char[7];
+        for (int i = 0; i < c.length; i++) c[i] = ALPHABET.charAt(random.nextInt(ALPHABET.length()));
+        return new String(c);
+    }
+}
