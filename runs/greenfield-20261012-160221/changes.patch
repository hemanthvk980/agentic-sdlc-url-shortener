+package io.github.hemanthvk980.shortener.web;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class LinkApiTest {
+    @Autowired MockMvc mvc;
+    @Autowired ObjectMapper json;
+
+    private String create(String url) throws Exception {
+        String body = mvc.perform(post("/api/v1/links").contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\":\"" + url + "\"}"))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.code").value(org.hamcrest.Matchers.matchesPattern("^[0-9A-Za-z]{7}$")))
+                .andReturn().getResponse().getContentAsString();
+        return json.readTree(body).get("code").asText();
+    }
+
+    @Test
+    void ac1_and_ac2_createThenRedirect() throws Exception {
+        String code = create("https://example.com/docs");
+        mvc.perform(get("/" + code)).andExpect(status().isFound())
+                .andExpect(header().string("Location", "https://example.com/docs"));
+    }
+
+    @Test
+    void ac3_rejectsUnsafeUrls() throws Exception {
+        for (String bad : new String[] {"javascript:alert(1)", "http://127.0.0.1/admin"}) {
+            mvc.perform(post("/api/v1/links").contentType(MediaType.APPLICATION_JSON).content("{\"url\":\"" + bad + "\"}"))
+                    .andExpect(status().isBadRequest());
+        }
+    }
+
+    @Test
+    void ac4_unknownCodeIs404() throws Exception {
+        mvc.perform(get("/zzzzzzz")).andExpect(status().isNotFound());
+    }
+
+    @Test
+    void ac5_statsCountClicks() throws Exception {
+        String code = create("https://example.com/stats");
+        mvc.perform(get("/" + code));
+        mvc.perform(get("/" + code));
+        for (int i = 0; i < 50; i++) {
+            String s = mvc.perform(get("/api/v1/links/" + code + "/stats")).andReturn().getResponse().getContentAsString();
+            if (json.readTree(s).get("totalClicks").asLong() == 2) return;
+            Thread.sleep(100);
+        }
+        throw new AssertionError("clicks were not recorded");
+    }
+}
